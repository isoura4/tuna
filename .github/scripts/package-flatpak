#!/usr/bin/env zsh

builtin emulate -L zsh
setopt EXTENDED_GLOB
setopt PUSHD_SILENT
setopt ERR_EXIT
setopt ERR_RETURN
setopt NO_UNSET
setopt PIPE_FAIL
setopt NO_AUTO_PUSHD
setopt NO_PUSHD_IGNORE_DUPS
setopt FUNCTION_ARGZERO

## Enable for script debugging
# setopt WARN_CREATE_GLOBAL
# setopt WARN_NESTED_VAR
# setopt XTRACE

autoload -Uz is-at-least && if ! is-at-least 5.2; then
  print -u2 -PR "${CI:+::error::}%F{1}${funcstack[1]##*/}:%f Running on Zsh version %B${ZSH_VERSION}%b, but Zsh %B5.2%b is the minimum supported version. Upgrade Zsh to fix this issue."
  exit 1
fi

TRAPZERR() {
  if (( ${_loglevel:-3} > 2 )) {
    print -u2 -PR "${CI:+::error::}%F{1}    ✖︎ script execution error%f"
    print -PR -e "
    Callstack:
    ${(j:\n     :)funcfiletrace}
    "
  }

  exit 2
}

package() {
  if (( ! ${+SCRIPT_HOME} )) typeset -g SCRIPT_HOME=${ZSH_ARGZERO:A:h}
  local host_os='ubuntu'
  local project_root=${SCRIPT_HOME:A:h:h}
  local buildspec_file=${project_root}/buildspec.json

  fpath=("${SCRIPT_HOME}/utils.zsh" ${fpath})
  autoload -Uz set_loglevel log_info log_group log_error log_output check_${host_os}

  if [[ ! -r ${buildspec_file} ]] {
    log_error \
      'No buildspec.json found. Please create a build specification for your project.'
    return 2
  }

  local -i verbosity=1
  local -r _version='1.0.0'
  local -r -a _valid_targets=(
    ubuntu-x86_64
  )
  local target
  local config='RelWithDebInfo'
  local -r -a _valid_configs=(Debug RelWithDebInfo Release MinSizeRel)
  local -i skip_deps=0

  local -r _usage="
Usage: %B${functrace[1]%:*}%b <option> [<options>]

%BOptions%b:

%F{yellow} Package configuration options%f
 -----------------------------------------------------------------------------
  %B-t | --target%b                     Specify target
  %B-c | --config%b                     Build configuration
  %B--skip-deps%b                       Skip checking for dependencies

%F{yellow} Output options%f
 -----------------------------------------------------------------------------
  %B-q | --quiet%b                      Quiet (error output only)
  %B-v | --verbose%b                    Verbose (more detailed output)
  %B--debug%b                           Debug (very detailed and added output)

%F{yellow} General options%f
 -----------------------------------------------------------------------------
  %B-h | --help%b                       Print this usage help
  %B-V | --version%b                    Print script version information
${_usage_host:-}"

  local -a args
  while (( # )) {
    case ${1} {
      -t|--target|-c|--config)
        if (( # == 1 )) || [[ ${2:0:1} == '-' ]] {
          log_error "Missing value for option %B${1}%b"
          log_output ${_usage}
          exit 2
        }
        ;;
    }
    case ${1} {
      --)
        shift
        args+=($@)
        break
        ;;
      -t|--target)
        if (( ! ${_valid_targets[(Ie)${2}]} )) {
          log_error "Invalid value %B${2}%b for option %B${1}%b"
          log_output ${_usage}
          exit 2
        }
        target=${2}
        shift 2
        ;;
      -c|--config)
        if (( !${_valid_configs[(Ie)${2}]} )) {
          log_error "Invalid value %B${2}%b for option %B${1}%b"
          log_output ${_usage}
          exit 2
        }
        config=${2}
        shift 2
        ;;
      --skip-deps) typeset -g skip_deps=1; shift ;;
      -q|--quiet) (( verbosity -= 1 )) || true; shift ;;
      -v|--verbose) (( verbosity += 1 )); shift ;;
      -h|--help) log_output ${_usage}; exit 0 ;;
      -V|--version) print -Pr "${_version}"; exit 0 ;;
      --debug) verbosity=3; shift ;;
      *) log_error "Unknown option: %B${1}%b"; log_output ${_usage}; exit 2 ;;
    }
  }

  : "${target:="${host_os}-${CPUTYPE}"}"

  set -- ${(@)args}
  set_loglevel ${verbosity}

  if (( ! skip_deps )) {
    check_${host_os}
  }

  if ! command -v flatpak >/dev/null; then
    log_error 'No flatpak command found. Please install flatpak.'
    return 2
  fi

  local product_name
  local product_version
  read -r product_name product_version <<< \
    "$(jq -r '. | {name, version} | join(" ")' ${buildspec_file})"

  local install_root="${project_root}/release/${config}"
  if [[ ! -d "${install_root}" ]] {
    log_error "No release artifact found at '${install_root}'. Run the build script first."
    return 2
  }

  local arch="${target##*-}"
  local flatpak_arch
  case "${arch}" {
    x86_64) flatpak_arch='x86_64' ;;
    aarch64|arm64) flatpak_arch='aarch64' ;;
    *)
      log_error "Unsupported target architecture for Flatpak packaging: ${arch}"
      return 2
      ;;
  }

  local flatpak_id
  flatpak_id="$(jq -r '.platformConfig.macos.bundleId // .name' ${buildspec_file}).plugin"
  if [[ ! "${flatpak_id}" =~ '^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)+$' ]] {
    log_error "Invalid Flatpak application ID: ${flatpak_id}"
    return 2
  }

  local runtime="${FLATPAK_RUNTIME:-org.freedesktop.Platform}"
  local sdk="${FLATPAK_SDK:-org.freedesktop.Sdk}"
  local branch="${FLATPAK_BRANCH:-24.08}"

  local temp_root="${project_root}/release/.flatpak/${product_name}-${product_version}-${flatpak_arch}"
  local build_root="${temp_root}/build"
  local repo_root="${temp_root}/repo"
  local bundle_path="${project_root}/release/${product_name}-${product_version}-${flatpak_arch}.flatpak"
  local launcher_command="${product_name}"

  rm -rf "${temp_root}"
  mkdir -p "${temp_root}"
  rm -f "${bundle_path}"

  if ! flatpak --user info "${runtime}//${branch}" --arch="${flatpak_arch}" >/dev/null 2>&1 \
    || ! flatpak --user info "${sdk}//${branch}" --arch="${flatpak_arch}" >/dev/null 2>&1; then
    log_group "Installing Flatpak runtime dependencies (${branch})..."
    flatpak --user remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    flatpak --user install --noninteractive flathub \
      "${runtime}//${branch}" \
      "${sdk}//${branch}"
  fi

  log_group "Creating Flatpak bundle for ${product_name}..."
  flatpak build-init \
    --arch="${flatpak_arch}" \
    "${build_root}" \
    "${flatpak_id}" \
    "${runtime}" \
    "${sdk}" \
    "${branch}"

  mkdir -p "${build_root}/files"
  mkdir -p "${build_root}/files/bin" "${build_root}/files/share/applications"
  cat << EOF > "${build_root}/files/bin/${launcher_command}"
#!/usr/bin/env sh
echo "${product_name} is an OBS plugin package. Launch OBS Studio in Flatpak to use it." >&2
exec /usr/bin/true
EOF
  chmod +x "${build_root}/files/bin/${launcher_command}"
  cat << EOF > "${build_root}/files/share/applications/${flatpak_id}.desktop"
[Desktop Entry]
Type=Application
Name=${product_name}
Exec=${launcher_command}
Terminal=true
Categories=Utility;
EOF
  if [[ -d "${install_root}/lib" ]] cp -a "${install_root}/lib" "${build_root}/files/"
  if [[ -d "${install_root}/lib64" ]] cp -a "${install_root}/lib64" "${build_root}/files/"
  if [[ -d "${install_root}/share" ]] cp -a "${install_root}/share" "${build_root}/files/"

  flatpak build-finish --command="${launcher_command}" "${build_root}"
  flatpak build-export --arch="${flatpak_arch}" "${repo_root}" "${build_root}" "${branch}"
  flatpak build-bundle --arch="${flatpak_arch}" "${repo_root}" "${bundle_path}" "${flatpak_id}" "${branch}"
  if [[ ! -s "${bundle_path}" ]] {
    log_error "Flatpak bundle was not generated at '${bundle_path}'."
    return 2
  }
  rm -rf "${temp_root}"
  log_group
}

package ${@}
